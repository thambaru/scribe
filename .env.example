# Google Calendar & OAuth
# Setup: https://console.cloud.google.com → Create OAuth 2.0 Credentials
export GOOGLE_CLIENT_ID="your-google-client-id"
export GOOGLE_CLIENT_SECRET="your-google-client-secret"
export GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"

# Google Gemini - AI-powered content generation
# Get API key at: https://aistudio.google.com/app/apikey
export GEMINI_API_KEY="your-gemini-api-key"
export GEMINI_MODEL="gemini-2.5-flash-lite"

# Recall.ai - Automated meeting transcription bot
# Setup: https://www.recall.ai/ → Dashboard → API Keys
# Note: Verify RECALL_REGION matches your account settings
export RECALL_API_KEY=
export RECALL_REGION=us-west-2

# HubSpot CRM integration (requires Legacy Apps)
# Setup: https://app.hubspot.com/developer → Create App
export HUBSPOT_CLIENT_ID=
export HUBSPOT_CLIENT_SECRET=
export HUBSPOT_REDIRECT_URI=http://localhost:4000/auth/hubspot/callback

# Salesforce CRM integration
# Sign up at: https://developer.salesforce.com/signup
# Setup: Salesforce Setup → App Manager → New Connected App
export SALESFORCE_CLIENT_ID=
export SALESFORCE_CLIENT_SECRET=
export SALESFORCE_REDIRECT_URI=http://localhost:4000/auth/salesforce/callback
export SALESFORCE_SITE=https://login.salesforce.com

# LinkedIn - Professional network sharing and engagement
# Setup: https://www.linkedin.com/developers/apps → Create App
# Allow "Sign in with LinkedIn" and "Share on LinkedIn" permissions
export LINKEDIN_CLIENT_ID=
export LINKEDIN_CLIENT_SECRET=
export LINKEDIN_REDIRECT_URI=http://localhost:4000/auth/linkedin/callback

# Facebook - Social publishing and audience engagement
# Setup: https://developers.facebook.com/apps → Create App
# Product: Facebook Login, Facebook Share Dialog
# Note: Will require selecting a Page after authentication
export FACEBOOK_CLIENT_ID=
export FACEBOOK_CLIENT_SECRET=
export FACEBOOK_REDIRECT_URI=http://localhost:4000/auth/facebook/callback

# Production deployment (uncomment and configure)
# DATABASE_URL=ecto://USER:PASS@HOST/database_name
# SECRET_KEY_BASE=  # Generate with: mix phx.gen.secret

# Server configuration (optional)
# PHX_HOST=your-domain.com
# PORT=4000
# PHX_SERVER=true